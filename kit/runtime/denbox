#!/usr/bin/env bash
# The runtime of a box. See docs/design.md, "Layout in a box" and "Sync".
#
#   denbox supervise                       s6 over the services and the sync loop, under tini or systemd
#   denbox sync [--once]                   fetch, build, activate or leave pending, reconcile services
#   denbox pending                         print the box that waits for approval, as JSON
#   denbox apply [REVISION]                activate the pending box; with REVISION, only that one
#   denbox host                            print what the box asks of its host, as JSON
#   denbox service status [NAME]
#   denbox service start|stop|restart NAME
#   denbox service reconcile               make the supervised services match ~/.config/denbox/services now
#   denbox service logs NAME [-f] [-n N]
#   denbox shell [ARGS]                    the configured shell, bash without it
#
# Every path comes from a variable, so tests point the runtime at temporary
# directories. The defaults are the box's layout.
set -euo pipefail
umask 077

# The package sets this to the bin directories of the runtime's own tools.
tools='' # set by the package
user_path=$PATH
[[ -z $tools ]] || PATH=$tools:$PATH

state=${DENBOX_STATE:-$HOME/.local/state/denbox}
# In a container the box runs as root. On a machine a box may run as any
# user, so each user has a directory of its own, made by the box's unit.
if ((EUID == 0)); then run=/run/denbox; else run=/run/denbox-$(id -un); fi
run=${DENBOX_RUN:-$run}
config=${DENBOX_CONFIG:-$HOME/.config/denbox}
bootstrap_file=${DENBOX_BOOTSTRAP:-/run/secrets/denbox_bootstrap}
token_file=${DENBOX_GIT_TOKEN:-/run/secrets/denbox_git_token}
profile_runtime=${DENBOX_PROFILE_RUNTIME:-$HOME/.nix-profile/bin/denbox}
# Store maintenance after an activation: generations kept, seconds between runs.
gc_keep=${DENBOX_GC_KEEP:-3}
gc_interval=${DENBOX_GC_INTERVAL:-86400}
# The kit's binary cache (docs/design.md, Binary cache), added to whatever the
# host configures, on every nix call that can build. DENBOX_BINARY_CACHE=0
# leaves it out. An unreachable cache is a warning; Nix builds without it.
cache_options=()
if [[ ${DENBOX_BINARY_CACHE:-1} != 0 ]]; then
  cache_options=(--extra-substituters https://denbox.cachix.org
    --extra-trusted-public-keys denbox.cachix.org-1:0wTpaHGYAg3yirdzhxYjNPnzPjVjBiNoMHaK4Hptx9I=)
fi

self=$(readlink -f "${BASH_SOURCE[0]}")
libexec=$(dirname "$self")
services=$run/services
logs=$state/logs
sync_service=denbox-sync
name_pattern='^[a-z][a-z0-9-]*$'

usage() {
  sed -n '3,12s/^# //p' "$self" >&2
  exit 64
}

# supervise: lays out the s6 scan directory, restores the last applied
# services without network, and becomes s6-svscan.
supervise() {
  # One supervisor per box. A second one over the same directory would take
  # the services away from the first; a running one answers on its control pipe.
  if s6-svscanctl -a "$services" 2>/dev/null; then
    echo "This box is already supervised; see 'denbox service status'" >&2
    exit 75
  fi
  # What an earlier supervisor left behind, when $run outlived it.
  rm -rf -- "$services"
  mkdir -p "$services" "$state"
  chmod 0700 "$run"
  service_dir "$sync_service"
  ln -sfn "$self" "$services/$sync_service/command"
  rm -f "$services/$sync_service/down"
  reconcile || echo 'Reconciling the cached services failed; the shell stays available' >&2
  # Services see the caller's PATH first and the runtime's tools after it;
  # s6-svscan finds s6-supervise there.
  PATH=$user_path${tools:+:$tools} exec s6-svscan "$services"
}

# service_dir NAME: links the s6 wrapper files of a service to this script,
# which acts as each by its name (see the end of this file). Nothing under
# $run has to be executable, so it may be a noexec tmpfs. ./command is the
# service's own executable.
service_dir() {
  local directory=$services/$1
  mkdir -p "$directory/log"
  ln -sfn "$self" "$directory/run"
  ln -sfn "$self" "$directory/finish"
  ln -sfn "$self" "$directory/log/run"
  printf '30000\n' > "$directory/timeout-kill"
}

# log_writer NAME: the log/run of every service. Keeps a copy on stdout for
# the container's log; 10 archives of 1 MB with ISO 8601 timestamps.
log_writer() {
  local directory=$logs/$1
  mkdir -p "$directory"
  chmod 0700 "$logs" "$directory"
  exec s6-log -b -- 1 n10 s1000000 T "$directory"
}

# reconcile: makes the supervised services match $config/services. Every sync
# calls it, and so does `denbox service reconcile`, for a tool that changes
# the services between syncs. It prints nothing when nothing changed. A service
# restarts only when its executable changed. The wrapper links of every
# service are renewed, so they point at the runtime that runs now and not at
# one the store may collect.
reconcile() {
  local source=$config/services service name target fingerprint previous running gone
  mkdir -p "$services"
  exec 7>"$run/services.lock"
  flock -x 7
  shopt -s nullglob
  # Removed services whose supervisors took too long at an earlier reconcile.
  for service in "$services"/.removed-*; do
    s6-svok "$service" 2>/dev/null || s6-svok "$service/log" 2>/dev/null || rm -rf -- "$service"
  done
  for service in "$services"/*; do
    name=${service##*/}
    [[ -f $service/.managed && ! -x $source/$name/run ]] || continue
    touch "$service/down"
    if s6-svok "$service" 2>/dev/null || s6-svok "$service/log" 2>/dev/null; then
      # s6-svscan forgets a service only when its supervisor exits after a
      # scan found the directory gone. Before s6 2.15 it never forgets one
      # whose supervisor exited first, and refuses every later directory with
      # the same inode, so a new service would not start. The directory
      # leaves the scan first, then s6-svscan stops both supervisors.
      gone=$services/.removed-$name
      if [[ -e $gone ]] || ! mv -- "$service" "$gone"; then
        echo "Service $name has not stopped; removal is retried at the next sync" >&2
        continue
      fi
      s6-svscanctl -an "$services" 2>/dev/null || { s6-svc -dx "$gone" 2>/dev/null; s6-svc -dx "$gone/log" 2>/dev/null; } || true
      for ((attempt = 0; attempt < 400; attempt++)); do
        s6-svok "$gone" 2>/dev/null || s6-svok "$gone/log" 2>/dev/null || break
        sleep .1
      done
      if s6-svok "$gone" 2>/dev/null || s6-svok "$gone/log" 2>/dev/null; then
        echo "Service $name has not stopped; removal is retried at the next sync" >&2
        continue
      fi
      service=$gone
    fi
    rm -rf -- "$service"
  done
  for service in "$source"/*; do
    name=${service##*/}
    [[ $name =~ $name_pattern && $name != "$sync_service" && -x $service/run ]] || continue
    target=$(readlink -f "$service")
    fingerprint=$target
    previous=$(cat "$services/$name/.managed" 2>/dev/null || true)
    if [[ $fingerprint == "$previous" ]]; then
      service_dir "$name"
      [[ ! -x $target/finish ]] || ln -sfn "$target/finish" "$services/$name/finish"
      continue
    fi
    running=false
    if s6-svok "$services/$name" 2>/dev/null; then
      running=true
      s6-svc -wD -T 35000 -d "$services/$name" || true
    fi
    # Wrapper files live under $run, never in the read-only store: s6 writes
    # supervise/ next to them. log/ exists before s6-svscan sees the directory.
    service_dir "$name"
    ln -sfn "$target/run" "$services/$name/command"
    [[ ! -x $target/finish ]] || ln -sfn "$target/finish" "$services/$name/finish"
    printf '%s\n' "$fingerprint" > "$services/$name/.managed"
    rm -f "$services/$name/down"
    if [[ $running == true ]]; then s6-svc -u "$services/$name"; fi
  done
  shopt -u nullglob
  service_dir "$sync_service"
  ln -sfn "$self" "$services/$sync_service/command"
  if [[ -p $services/.s6-svscan/control ]]; then s6-svscanctl -an "$services"; fi
  exec 7>&-
}

# service ACTION [NAME] [OPTIONS]: the supervisor's interface, used by people,
# by denbox-api and by tools that write services. status prints
# "NAME: <s6-svstat line>" per service.
service() {
  local action=${1:-status} name=${2:-}
  if [[ -n $name ]]; then
    # Logs stay readable after a service is removed.
    [[ $name =~ $name_pattern && (-d $services/$name || ($action == logs && -d $logs/$name)) ]] ||
      { echo "Unknown service: $name" >&2; exit 64; }
  fi
  case $action in
    status)
      local directory
      for directory in "$services"/${name:-*}; do
        [[ -d $directory ]] || continue
        printf '%s: ' "${directory##*/}"
        s6-svstat "$directory"
      done ;;
    start|stop|restart)
      [[ -n $name ]] || usage
      case $action in
        start) s6-svc -u "$services/$name" ;;
        stop) s6-svc -wD -T 35000 -d "$services/$name" ;;
        # One request, so s6 brings the service back even when the caller runs
        # inside it and dies with it. -r before -u: a down service starts once.
        restart) s6-svc -wr -T 40000 -ru "$services/$name" ;;
      esac ;;
    reconcile)
      [[ -z $name ]] || usage
      reconcile ;;
    logs)
      [[ -n $name ]] || usage
      shift 2
      local lines=100 tail_options=()
      while (($#)); do
        case $1 in
          -f) tail_options=(-F) ;;
          -n) [[ ${2:-} =~ ^[0-9]+$ ]] || usage; lines=$2; shift ;;
          *) usage ;;
        esac
        shift
      done
      # -F follows "current" across rotation.
      exec tail -n "$lines" "${tail_options[@]}" "$logs/$name/current" ;;
    *) usage ;;
  esac
}

# read_bootstrap: prints the path of the last valid bootstrap. A file the host
# broke leaves the previous one in use.
read_bootstrap() {
  local cache=$state/bootstrap.json candidate
  candidate=$(mktemp "$state/.bootstrap.XXXXXX")
  if jq -e '
       .version == 2 and
       (.repository | type == "string" and length > 0) and
       (.ref | type == "string" and length > 0) and
       (.box | type == "string" and test("^[A-Za-z0-9_-]+$")) and
       ((.sync_interval // 300) | type == "number" and floor == . and . >= 30 and . <= 86400) and
       ((.apply_timeout // 1800) | type == "number" and floor == . and . >= 30 and . <= 86400) and
       ((.git_username // "oauth2") | type == "string" and test("^[A-Za-z0-9_.@-]+$"))
     ' "$bootstrap_file" > /dev/null 2>&1 &&
     git check-ref-format "refs/heads/$(jq -r .ref "$bootstrap_file")" &&
     cp "$bootstrap_file" "$candidate"; then
    mv -f "$candidate" "$cache"
  else
    rm -f "$candidate"
    echo "The bootstrap $bootstrap_file is missing or not valid; the last valid one stays in use" >&2
  fi
  [[ -s $cache ]] || { echo 'No valid bootstrap yet' >&2; return 75; }
  printf '%s\n' "$cache"
}

# git_fetch ARGS: git without the user's or the system's configuration, with
# the token through askpass and a time limit.
git_fetch() {
  GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 \
    GIT_ASKPASS=$libexec/askpass DENBOX_GIT_TOKEN=$token_file \
    timeout --foreground --kill-after=5s 120s \
    git -c credential.helper= -c http.followRedirects=false "$@"
}

# resolve REF: prints the locked attributes of the revision REF names now.
# Nix asks the host and evaluates nothing. When the host fails, Nix may fall
# back to the revision it saw last with a warning; that is a failure here.
resolve() {
  local output result=0
  # Called in a loop over stdin; nix gets none of it. Without the global flake
  # registry: a followed reference names its host itself, and with --refresh
  # Nix would otherwise download the registry at every sync and fail without it.
  output=$(nix flake prefetch --refresh --json --option flake-registry '' "$1" < /dev/null 2>"$state/resolve.log") || result=$?
  cat "$state/resolve.log" >&2
  if ((result == 0)) && grep -q 'using cached version' "$state/resolve.log"; then result=69; fi
  ((result == 0)) || { echo "Could not resolve $1" >&2; return "$result"; }
  jq -c .locked <<<"$output"
}

# fetch_box BOOTSTRAP: steps 1 and 2 of the design's Sync section and the
# resolution of every followed reference, for sync_once and host. Sets the
# caller's box, revision, snapshot, follow, resolved and overrides.
fetch_box() {
  local repository ref entry locked pinned applied_revision applied_box
  repository=$(jq -r .repository "$1")
  ref=$(jq -r .ref "$1")
  box=$(jq -r .box "$1")
  DENBOX_GIT_USERNAME=$(jq -r '.git_username // "oauth2"' "$1")
  export DENBOX_GIT_USERNAME

  # 1. Fetch the ref and unpack it into a snapshot without .git.
  [[ -d $state/source.git ]] || git init -q --bare "$state/source.git"
  git_fetch --git-dir="$state/source.git" fetch -q --depth=1 "$repository" "refs/heads/$ref"
  revision=$(git --git-dir="$state/source.git" rev-parse FETCH_HEAD)
  snapshot=$state/snapshots/$revision
  if [[ ! -d $snapshot ]]; then
    mkdir -p "$state/snapshots"
    local incoming
    incoming=$(mktemp -d "$state/snapshots/.incoming.XXXXXX")
    git --git-dir="$state/source.git" archive "$revision" | tar -x -C "$incoming"
    mv "$incoming" "$snapshot"
  fi

  # 2. Read follow. It changes only with the revision, so the value recorded
  # with the applied revision is used again and an idle box evaluates nothing.
  read -r applied_revision applied_box _ 2>/dev/null < "$state/fingerprint" || true
  if [[ $revision == "${applied_revision:-}" && $box == "${applied_box:-}" && -f $state/follow ]]; then
    follow=$(< "$state/follow")
  elif [[ "$revision $box" == "$(jq -r '"\(.revision) \(.box)"' "$state/pending.json" 2>/dev/null)" ]]; then
    follow=$(jq -cS .follow "$state/pending.json")
  else
    follow=$(nix eval "${cache_options[@]}" --no-write-lock-file --json "path:$snapshot#boxes.$box.follow")
    jq -e 'type == "object" and all(to_entries[];
             (.key | test("^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$")) and (.value | type == "string" and length > 0))' \
      <<<"$follow" > /dev/null || { echo "boxes.$box.follow is not an attribute set of flake references" >&2; return 65; }
    follow=$(jq -cS . <<<"$follow")
  fi

  # Every followed reference resolved to its revision now, and pinned there
  # as --override-input, so what is evaluated is what the fingerprint names.
  resolved='{}'
  while IFS= read -r -d '' entry; do
    locked=$(resolve "${entry#*=}")
    resolved=$(jq -cS --arg name "${entry%%=*}" --argjson locked "$locked" '.[$name] = $locked' <<<"$resolved")
  done < <(jq -j 'to_entries[] | "\(.key)=\(.value)\u0000"' <<<"$follow")
  overrides=()
  if [[ $resolved != '{}' ]]; then
    pinned=$(DENBOX_LOCKED=$resolved nix eval --impure --json --expr \
      'builtins.mapAttrs (_: builtins.flakeRefToString) (builtins.fromJSON (builtins.getEnv "DENBOX_LOCKED"))')
    while IFS= read -r -d '' entry; do overrides+=(--override-input "${entry%%=*}" "${entry#*=}"); done \
      < <(jq -j 'to_entries[] | "\(.key)=\(.value)\u0000"' <<<"$pinned")
  fi
}

# apply_mode BOX: the denbox.apply of a built box. The apply module writes
# the file into the home files of a box that asks for approval, and no other.
apply_mode() {
  if [[ $(cat "$1/home-files/.config/denbox/apply" 2>/dev/null) == approve ]]; then echo approve; else echo auto; fi
}

# pending_fingerprint: the fingerprint of the box that waits for approval.
# Prints nothing when none waits, or when the build the record names is not
# the candidate any more.
pending_fingerprint() {
  [[ -s $state/pending.json ]] || return 0
  [[ $(readlink -f "$state/candidate" 2>/dev/null) == "$(jq -r .store "$state/pending.json")" ]] || return 0
  printf '%s %s %s\n' "$(jq -r .revision "$state/pending.json")" "$(jq -r .box "$state/pending.json")" \
    "$(jq -cS .resolved "$state/pending.json")"
}

# write_pending SUBJECT: records the candidate as waiting for approval, from
# the caller's revision, box, follow and resolved. `apply` is the mode the box
# would have once applied, and `changes` what `nix store diff-closures` says
# of the applied box and this one, as lines; it is left empty when Nix cannot
# say.
write_pending() {
  local candidate applied changes record
  candidate=$(readlink -f "$state/candidate")
  applied=$(readlink -f "$state/applied")
  changes=$(nix store diff-closures "$applied" "$candidate" 2>/dev/null |
    jq -Rn '[inputs | gsub("\u001b\\[[0-9;]*m"; "") | select(length > 0)]') || changes='[]'
  record=$(mktemp "$state/.pending.XXXXXX")
  jq -n --arg revision "$revision" --arg box "$box" --arg subject "$1" --arg store "$candidate" \
    --arg applied "$(cat "$state/revision" 2>/dev/null || true)" --arg apply "$(apply_mode "$candidate")" \
    --arg built "$(date -u +%FT%TZ)" --argjson follow "$follow" --argjson resolved "$resolved" \
    --argjson changes "${changes:-[]}" '{
      revision: $revision, box: $box, subject: $subject, built: $built, store: $store,
      applied: (if $applied == "" then null else $applied end),
      apply: $apply, changes: $changes, follow: $follow, resolved: $resolved
    }' > "$record"
  mv -f "$record" "$state/pending.json"
}

# activate_candidate TIMEOUT: step 4 of the design's Sync section, for
# sync_once and apply. Activates the candidate unless it is the applied box
# already, records the caller's revision, follow and fingerprint as applied,
# and reconciles the services.
activate_candidate() {
  local candidate applied old
  candidate=$(readlink -f "$state/candidate")
  applied=$(readlink -f "$state/applied" 2>/dev/null || true)
  if [[ $candidate != "$applied" ]]; then
    echo "Activating $candidate"
    timeout --foreground --kill-after=10s "$1" "$candidate/activate"
    # A GC root for the applied box, under its own name.
    nix build --out-link "$state/applied" "$candidate"
  fi
  rm -f "$state/candidate" "$state/pending.json"
  printf '%s\n' "$follow" > "$state/follow"
  printf '%s\n' "$fingerprint" > "$state/fingerprint"
  printf '%s\n' "$revision" > "$state/revision"
  reconcile

  # Old snapshots are in the store already, as the source of their builds.
  for old in "$state"/snapshots/*; do
    [[ ${old##*/} == "$revision" ]] || rm -rf -- "$old"
  done
  maintain_store || echo 'Store maintenance failed; it is retried after the next activation' >&2
}

# sync_once: one pass of the four steps of the design's Sync section. Any
# failure exits before the applied state changes. A box whose applied
# environment sets denbox.apply to approve stops after the build and leaves
# the result pending, for `denbox apply`.
sync_once() {
  local cache box deadline revision snapshot follow resolved
  local fingerprint candidate applied started remaining
  local overrides=()
  cache=$(read_bootstrap)
  deadline=$(jq -r '.apply_timeout // 1800' "$cache")
  jq -r '.sync_interval // 300' "$cache" > "$state/interval"
  fetch_box "$cache"
  fingerprint="$revision $box $resolved"
  if [[ -e $state/applied && $fingerprint == "$(cat "$state/fingerprint" 2>/dev/null)" ]]; then
    # The branch is back at what the box runs: nothing waits any more.
    rm -f "$state/candidate" "$state/pending.json"
    reconcile
    return 0
  fi
  if [[ $fingerprint == "$(pending_fingerprint)" ]]; then
    reconcile
    return 0
  fi

  # 3. Build against the resolved revisions, so the box is what the
  # fingerprint names. They are pinned, so the build needs no --refresh.
  echo "Building boxes.$box at $revision"
  started=$SECONDS
  timeout --foreground --kill-after=10s "$deadline" \
    nix build "${cache_options[@]}" --no-write-lock-file --out-link "$state/candidate" "${overrides[@]}" "path:$snapshot#boxes.$box"
  candidate=$(readlink -f "$state/candidate")
  applied=$(readlink -f "$state/applied" 2>/dev/null || true)

  # The mode in force is the applied box's own, so a revision that switches
  # approval off waits for approval itself. A first build, and a revision
  # that builds the box already applied, have nothing to ask about.
  if [[ -n $applied && $candidate != "$applied" && $(apply_mode "$applied") == approve ]]; then
    write_pending "$(git --git-dir="$state/source.git" log -1 --format=%s "$revision")"
    echo "boxes.$box at $revision waits for approval: denbox apply $revision"
    reconcile
    return 0
  fi

  # 4. Activate, then reconcile the services.
  remaining=$((deadline - (SECONDS - started)))
  ((remaining > 0)) || remaining=1
  activate_candidate "$remaining"
}

# apply_pending [REVISION]: activates the box that waits for approval. With
# REVISION it refuses any other, so an approval of one revision never applies
# the next one that arrived meanwhile.
apply_pending() {
  local wanted=${1:-} revision follow fingerprint deadline=1800
  fingerprint=$(pending_fingerprint)
  if [[ -z $fingerprint ]]; then
    echo 'Nothing waits for approval' >&2
    [[ -z $wanted ]] || exit 65
    return 0
  fi
  revision=$(jq -r .revision "$state/pending.json")
  [[ -z $wanted || $wanted == "$revision" ]] ||
    { echo "$revision waits for approval, not $wanted" >&2; exit 65; }
  follow=$(jq -cS .follow "$state/pending.json")
  [[ ! -s $state/bootstrap.json ]] || deadline=$(jq -r '.apply_timeout // 1800' "$state/bootstrap.json")
  activate_candidate "$deadline"
  printf '%s applied %s\n' "$(date -u +%FT%TZ)" "$revision" > "$state/status"
}

# apply [REVISION]: `denbox apply`. It waits for a running sync pass to end.
apply() {
  (($# <= 1)) || usage
  mkdir -p "$state" "$run"
  exec 9>"$run/state.lock"
  flock 9
  # What the activation starts must not hold the lock after it.
  (apply_pending "$@") 9>&-
}

# pending: `denbox pending`. Prints the record of the box that waits for
# approval, nothing when none waits.
pending() {
  [[ -z $(pending_fingerprint) ]] || cat "$state/pending.json"
}

# host: prints boxes.<box>.host of the bootstrap's environment, fetched and
# followed as a sync would, building nothing. install.sh runs it in a
# throwaway container of the image over the box's Nix volume, so what the
# evaluation fetches is in the store for the box's first build.
host() {
  local cache box revision snapshot follow resolved
  local overrides=()
  mkdir -p "$state"
  cache=$(read_bootstrap)
  fetch_box "$cache"
  nix eval "${cache_options[@]}" --no-write-lock-file --json "${overrides[@]}" "path:$snapshot#boxes.$box.host"
}

# maintain_store: at most once per gc_interval, keeps gc_keep generations of
# the user's profiles and collects the store. Roots outside them, such as the
# image's seed, stay.
maintain_store() {
  local now last=0 profile
  ((gc_interval > 0)) || return 0
  now=$(date +%s)
  [[ ! -f $state/last-gc ]] || read -r last < "$state/last-gc"
  [[ $last =~ ^[0-9]+$ ]] || last=0
  ((now - last >= gc_interval)) || return 0
  echo "Maintaining the store: keeping $gc_keep generations"
  # Home Manager and nix profile use either location, depending on Nix's settings.
  for profile in "${XDG_STATE_HOME:-$HOME/.local/state}"/nix/profiles/{home-manager,profile} \
    "/nix/var/nix/profiles/per-user/${USER:-$(id -un)}"/{home-manager,profile}; do
    [[ ! -L $profile ]] || nix-env --profile "$profile" --delete-generations "+$gc_keep" || return
  done
  nix store gc || return
  printf '%s\n' "$now" > "$state/last-gc"
}

# sync_loop [--once]: the reconciler. Only one runs at a time; a failure keeps the
# box as it was. The loop exits when the runtime in the profile is not the
# one it started with, after a pass or a `denbox apply` between two, so s6
# starts the new one. A pass and `denbox apply` exclude each other by the
# state lock.
sync_loop() {
  local once=false result runtime interval
  case ${1:-} in
    '') ;;
    --once) once=true ;;
    *) usage ;;
  esac
  mkdir -p "$state" "$run"
  exec 8>"$run/sync.lock"
  flock -n 8 || { echo 'A sync is already running' >&2; exit 75; }
  exec 9>"$run/state.lock"
  trap 'trap "" TERM INT; kill -TERM -- -$$ 2>/dev/null || true; wait; exit 0' TERM INT
  runtime=$(readlink -f "$profile_runtime" 2>/dev/null || true)
  while :; do
    flock 9
    printf '%s syncing\n' "$(date -u +%FT%TZ)" > "$state/status"
    set +e
    # Descendants must not hold the locks after the pass.
    (set -e; sync_once) 8>&- 9>&- &
    wait "$!"
    result=$?
    set -e
    if ((result != 0)); then
      printf '%s failed exit=%s; the box stays as it was\n' "$(date -u +%FT%TZ)" "$result" | tee "$state/status" >&2
    elif [[ -n $(pending_fingerprint) ]]; then
      printf '%s pending %s\n' "$(date -u +%FT%TZ)" "$(jq -r .revision "$state/pending.json")" > "$state/status"
    else
      printf '%s applied %s\n' "$(date -u +%FT%TZ)" "$(cat "$state/revision" 2>/dev/null)" > "$state/status"
    fi
    flock -u 9
    [[ $once == false ]] || exit "$result"
    if [[ $(readlink -f "$profile_runtime" 2>/dev/null || true) != "$runtime" ]]; then
      echo 'The runtime changed; s6 starts the new one'
      exit 0
    fi
    interval=300
    [[ ! -f $state/interval ]] || read -r interval < "$state/interval"
    sleep "$interval" &
    wait "$!" || true
  done
}

# shell [ARGS]: the shell the tools module configured, bash before the first
# activation or without it. It runs with the caller's PATH.
shell() {
  PATH=$user_path
  if [[ -x $config/shell ]]; then exec "$config/shell" "$@"; fi
  exec bash "$@"
}

# As s6 runs it through the links service_dir makes.
case ${0##*/} in
  run)
    if [[ ${PWD##*/} == log ]]; then log_writer "$(basename "$(dirname "$PWD")")"; fi
    # s6 sends only stdout to the log.
    exec 2>&1
    PATH=$user_path
    exec ./command ;;
  # Exit code 256 is a stop by signal, and a service not wanted up was stopped
  # (the sync loop exits 0 on TERM); a crash waits a little before s6 restarts
  # it, less than the 5 seconds s6 allows a finish script before killing it.
  finish) [[ ${1:-} == 256 || $(s6-svstat -o wantedup . 2>/dev/null) == false ]] || sleep 4; exit 0 ;;
  # The sync loop: the box's own runtime once activation installed it.
  command)
    if [[ -x $profile_runtime && $(readlink -f "$profile_runtime") != "$self" ]]; then
      PATH=$user_path exec "$profile_runtime" sync
    fi
    sync_loop ;;
esac

command=${1:-}
[[ $# == 0 ]] || shift
case $command in
  supervise) [[ $# == 0 ]] || usage; supervise ;;
  sync) sync_loop "$@" ;;
  pending) [[ $# == 0 ]] || usage; pending ;;
  apply) apply "$@" ;;
  host) [[ $# == 0 ]] || usage; host ;;
  service) service "$@" ;;
  shell) shell "$@" ;;
  *) usage ;;
esac
