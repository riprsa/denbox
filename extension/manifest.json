{
  "manifest_version": 2,
  "name": "Denbox",
  "description": "Runs the browser parts of a denbox box.",
  "version": "1.0",
  "key": "",
  "permissions": [
    "tabs", "tabCapture", "nativeMessaging", "alarms", "storage", "unlimitedStorage",
    "bookmarks", "clipboardWrite", "cookies", "contextMenus", "notifications", "webNavigation",
    "webRequest", "webRequestBlocking", "<all_urls>"
  ],
  "background": { "scripts": ["bundle.js", "loader.js"], "persistent": true },
  "commands": {
    "shortcut-1": { "description": "Shortcut 1" },
    "shortcut-2": { "description": "Shortcut 2" },
    "shortcut-3": { "description": "Shortcut 3" },
    "shortcut-4": { "description": "Shortcut 4" }
  },
  "browser_action": { "default_title": "Denbox", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'"
}
